{
  "name": "webos-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "Minimalist home-screen launcher for LG webOS TVs (webOS 6 / Chrome 79 compatible)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5199",
    "build": "tsc --noEmit && vite build",
    "package": "sh scripts/package.sh",
    "manifest": "node scripts/gen-manifest.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@webos-tools/cli": "^3.2.6",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "preact": "^10.29.8",
    "zod": "^4.6.7"
  },
  "license": "MIT"
}
